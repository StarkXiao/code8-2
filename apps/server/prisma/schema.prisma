// 家庭食谱口述整理器 · 数据模型
//
// 说明：
// 1. SQLite 不支持数据库级 enum，所有状态字段以 String 存储，
//    取值集合由 packages/shared/src/enums.ts + Zod schema 在应用层约束。
// 2. SQLite 的 Json 支持在各版本间不一致，因此所有 JSON 字段统一以 String(TEXT)
//    存储，读写经 apps/server/src/lib/json.ts 序列化，避免跨版本行为差异。
// 3. 数据隔离边界是 Workspace：所有业务表都能沿着 recipeId / workspaceId 回溯到空间。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// 用户与空间
// ------------------------------------------------------------------

model User {
  id           String   @id
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships        WorkspaceMember[]
  ownedWorkspaces    Workspace[]        @relation("WorkspaceOwner")
  recipesCreated     Recipe[]           @relation("RecipeCreatedBy")
  versionsCreated    RecipeVersion[]    @relation("VersionCreatedBy")
  audioOwned         AudioAttachment[]  @relation("AudioOwner")
  clipsCreated       AudioClip[]        @relation("ClipCreatedBy")
  vagueItemsCreated  VagueItem[]        @relation("VagueCreatedBy")
  vagueItemsAssigned VagueItem[]        @relation("VagueAssignee")
  vagueItemsResolved VagueItem[]        @relation("VagueResolvedBy")
  comments           Comment[]
  verifications      VerificationRun[]
  notifications      Notification[]
  activities         ActivityLog[]
  referencesCreated  KitchenReference[]
  followupOverrides  FollowupTemplateOverride[]
}

model Workspace {
  id         String   @id
  name       String
  ownerId    String
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner      User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members    WorkspaceMember[]
  recipes    Recipe[]
  audio      AudioAttachment[]
  activities ActivityLog[]
  references KitchenReference[]
  followupTemplates FollowupTemplate[]
  followupOverrides FollowupTemplateOverride[]
}

model WorkspaceMember {
  id          String   @id
  workspaceId String
  userId      String
  role        String
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// 参照物登记：先把"家里那只勺、那只碗"量化一次，之后"一勺""一碗"才能换算成克。
/// 这是把模糊用量变成数值最有效的手段（项目文档 12.2）。
model KitchenReference {
  id          String   @id
  workspaceId String
  label       String
  amountValue Float
  amountUnit  String
  note        String?
  createdBy   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [createdBy], references: [id])

  @@unique([workspaceId, label])
}

// ------------------------------------------------------------------
// 追问话术模板（家族模板 → 个人继承/覆盖/停用）
// ------------------------------------------------------------------

/// 家族话术模板：一个空间至少有一个"默认模板"。
/// 继承语义靠"引用 + 稀疏覆盖"实现 —— 成员不加任何行就自动套用家族文案，
/// 所以新人加入时这里什么都不用写。
model FollowupTemplate {
  id          String   @id
  workspaceId String
  name        String
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     FollowupTemplateItem[]

  @@unique([workspaceId, name])
}

/// 模板里的一条话术。
/// ruleKey 非空：给某条内置模糊规则（packages/shared/src/rules.ts）提供问法；
/// ruleKey 为 null：自定义条目，转写文本里出现 triggerText 时触发。
/// enabled 是家族级开关 —— 整理者可以让一条话术对全家停用。
model FollowupTemplateItem {
  id               String   @id
  templateId       String
  ruleKey          String?
  category         String
  /// 自定义条目的触发词（ruleKey 为空时必填）
  triggerText      String?
  /// 支持 {原话} 占位符，渲染时用原句替换
  questionTemplate String
  sortOrder        Int      @default(0)
  enabled          Boolean  @default(true)
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  template  FollowupTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  overrides FollowupTemplateOverride[]

  // 一条内置规则在一个模板里最多对应一条话术；ruleKey 为 NULL 的自定义条目不受限
  @@unique([templateId, ruleKey])
  @@index([templateId, sortOrder])
}

/// 个人对某条话术的偏离：稀疏存储，只记"和家族不一样"的部分。
/// customQuestion 有值 = 个人改写；disabledAt 有值 = 临时停用（清空即恢复）。
/// 两个字段都为空时该行会被删除，回到完全继承状态。
model FollowupTemplateOverride {
  id             String    @id
  itemId         String
  userId         String
  /// 冗余自 item.template.workspaceId，用于按空间校验与清理，不信任客户端传值
  workspaceId    String
  customQuestion String?
  disabledAt     DateTime?
  /// 停用原因（可选），方便日后想起为什么停了这条
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  item      FollowupTemplateItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([workspaceId, userId])
}

// ------------------------------------------------------------------
// 食谱与版本
// ------------------------------------------------------------------

model Recipe {
  id           String   @id
  workspaceId  String
  title        String
  dishCategory String?
  coverUrl     String?
  status       String   @default("active")
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator       User              @relation("RecipeCreatedBy", fields: [createdBy], references: [id])
  versions      RecipeVersion[]
  audio         AudioAttachment[]
  vagueItems    VagueItem[]
  verifications VerificationRun[]

  @@index([workspaceId, status])
}

/// 版本一旦 published 即内容不可变，只能 fork 出新草稿（项目文档 13.1）。
model RecipeVersion {
  id              String    @id
  recipeId        String
  versionNo       Int
  parentVersionId String?
  status          String    @default("draft")
  title           String
  summary         String?
  changeNote      String?
  createdBy       String
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recipe        Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  creator       User            @relation("VersionCreatedBy", fields: [createdBy], references: [id])
  parent        RecipeVersion?  @relation("VersionFork", fields: [parentVersionId], references: [id])
  children      RecipeVersion[] @relation("VersionFork")
  steps         Step[]
  ingredients   Ingredient[]
  vagueItems    VagueItem[]
  verifications VerificationRun[]

  @@unique([recipeId, versionNo])
  @@index([recipeId, status])
}

model Step {
  id               String   @id
  versionId        String
  orderIndex       Int
  title            String
  instruction      String
  heatLevel        String?
  heatText         String?
  temperatureCMin  Float?
  temperatureCMax  Float?
  durationSecondsMin Int?
  durationSecondsMax Int?
  /// JSON 字符串数组：颜色/声音/气味/气泡等观察指标
  sensoryCues      String?
  tool             String?
  sourceClipId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  version    RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceClip AudioClip?    @relation("StepSourceClip", fields: [sourceClipId], references: [id])
  vagueItems VagueItem[]

  @@index([versionId, orderIndex])
}

model Ingredient {
  id          String   @id
  versionId   String
  orderIndex  Int
  name        String
  /// 原话，例如"一点"
  amountText  String?
  amountValue Float?
  amountUnit  String?
  amountMin   Float?
  amountMax   Float?
  isVague     Boolean  @default(false)
  vagueItemId String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  version   RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  vagueItem VagueItem?    @relation("IngredientVagueItem", fields: [vagueItemId], references: [id])

  @@index([versionId, orderIndex])
}

// ------------------------------------------------------------------
// 音频
// ------------------------------------------------------------------

/// 音频只增不改不删（软删除），是全部结论的最终证据。
model AudioAttachment {
  id               String    @id
  workspaceId      String
  recipeId         String
  ownerId          String
  kind             String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  durationMs       Int
  /// JSON 数字数组：客户端预计算的归一化波形峰值
  peaks            String?
  sha256           String
  transcript       String?
  transcriptStatus String    @default("none")
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipe    Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  owner     User      @relation("AudioOwner", fields: [ownerId], references: [id])
  clips     AudioClip[]

  @@index([recipeId, kind])
  @@index([recipeId, transcriptStatus])
}

model AudioClip {
  id                String   @id
  audioAttachmentId String
  startMs           Int
  endMs             Int
  label             String?
  createdBy         String
  createdAt         DateTime @default(now())

  audio            AudioAttachment @relation(fields: [audioAttachmentId], references: [id], onDelete: Cascade)
  creator          User            @relation("ClipCreatedBy", fields: [createdBy], references: [id])
  stepSources      Step[]          @relation("StepSourceClip")
  vagueItemClips   VagueItem[]     @relation("VagueItemClip")
  vagueItemAnswers VagueItem[]     @relation("VagueItemAnswerClip")

  @@index([audioAttachmentId])
}

// ------------------------------------------------------------------
// 待澄清条目（本项目核心工作对象）
// ------------------------------------------------------------------

model VagueItem {
  id               String    @id
  recipeId         String
  versionId        String?
  stepId           String?
  clipId           String?
  category         String
  rawPhrase        String
  transcript       String?
  status           String    @default("open")
  assigneeId       String?
  question         String?
  questionAskedAt  DateTime?
  answerText       String?
  answerClipId     String?
  answerAt         DateTime?
  /// JSON：ResolvedSpec
  resolvedSpec     String?
  confidence       String?
  unresolvableNote String?
  resolvedBy       String?
  resolvedAt       DateTime?
  /// 若由复做失败打回，指向那条验证记录
  reopenedFromVerificationId String?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  recipe     Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version    RecipeVersion?  @relation(fields: [versionId], references: [id])
  step       Step?           @relation(fields: [stepId], references: [id])
  clip       AudioClip?      @relation("VagueItemClip", fields: [clipId], references: [id])
  answerClip AudioClip?      @relation("VagueItemAnswerClip", fields: [answerClipId], references: [id])
  assignee   User?           @relation("VagueAssignee", fields: [assigneeId], references: [id])
  resolver   User?           @relation("VagueResolvedBy", fields: [resolvedBy], references: [id])
  creator    User            @relation("VagueCreatedBy", fields: [createdBy], references: [id])
  reopenedFrom VerificationRun? @relation("VerificationReopen", fields: [reopenedFromVerificationId], references: [id])
  ingredients Ingredient[]   @relation("IngredientVagueItem")

  @@index([recipeId, status])
  @@index([recipeId, category])
  @@index([assigneeId, status])
}

// ------------------------------------------------------------------
// 协作
// ------------------------------------------------------------------

/// 多态评论：targetType + targetId 指向任意实体（项目文档 8.2）。
model Comment {
  id         String    @id
  targetType String
  targetId   String
  authorId   String
  parentId   String?
  body       String
  /// JSON 字符串数组：被 @ 的用户 id
  mentions   String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  author  User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([targetType, targetId])
}

model VerificationRun {
  id          String   @id
  recipeId    String
  versionId   String
  performedBy String
  performedAt DateTime @default(now())
  result      String
  deviations  String?
  /// JSON 字符串数组
  photoUrls   String?
  voiceClipId String?
  createdAt   DateTime @default(now())

  recipe    Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version   RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  performer User          @relation(fields: [performedBy], references: [id])
  reopenedItems VagueItem[] @relation("VerificationReopen")

  @@index([recipeId, createdAt])
}

model Notification {
  id        String    @id
  userId    String
  type      String
  payload   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model ActivityLog {
  id          String   @id
  workspaceId String
  actorId     String
  action      String
  entityType  String
  entityId    String
  /// JSON：{ before, after }
  diff        String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}
